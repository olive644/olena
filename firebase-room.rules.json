{
  "rules": {
    "privateProfileHandles": { ".read": false, ".write": false },
    "privateProfileSocial": { ".read": false, ".write": false },
    "rooms": {
      ".indexOn": ["expiresAt"],
      "$code": {
        ".read": "data.child('expiresAt').isNumber() && data.child('expiresAt').val() > now",
        ".write": false
      }
    },
    "private-rooms": { ".indexOn": ["expiresAt"], ".read": false, ".write": false },
    "room-limits": { ".indexOn": ["expiresAt"], ".read": false, ".write": false },
    "speech-audio": { ".indexOn": ["expiresAt"], ".read": false, ".write": false },
    "room-recordings": { ".indexOn": ["expiresAt"], ".read": false, ".write": false },
    "speech-rate-limit": { ".indexOn": ["expiresAt"], ".read": false, ".write": false },
    "speech-generation-rate-limit": { ".indexOn": ["expiresAt"], ".read": false, ".write": false },
    "notebook-collab": { ".indexOn": ["expiresAt"], ".read": false, ".write": false },
    "notebook-views": { ".indexOn": ["expiresAt"], ".read": false, ".write": false },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "state": {
          ".validate": "newData.hasChildren(['version', 'updatedAt'])",
          "version": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "items": {
            "$key": {
              ".validate": "$key.matches(/^[A-Za-z0-9._:-]{1,100}$/) && newData.isString() && newData.val().length <= 20000000"
            }
          },
          "$other": { ".validate": false }
        },
        "stateV2": {
          ".validate": "newData.hasChildren(['version', 'updatedAt']) && newData.child('version').val() === 2 && (!data.child('items/k_aGVsZW5hLm1hdGhHYW1lLnY1').exists() || newData.child('items/k_aGVsZW5hLm1hdGhHYW1lLnY1').exists())",
          "version": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "items": {
            "$key": {
              ".validate": "$key.matches(/^k_[A-Za-z0-9_-]{1,98}$/) && newData.isString() && newData.val().length <= 20000000"
            }
          },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
