# Serviço de voz (Cloudflare Workers AI, modelo MeloTTS). Configure somente
# no ambiente seguro da Vercel. Nunca use prefixo VITE_: isso exporia o
# token no navegador. Crie a conta grátis (sem cartão) em
# dash.cloudflare.com/sign-up, pegue o Account ID no painel e gere um API
# Token em "My Profile > API Tokens" com permissão "Workers AI - Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
TTS_TIMEOUT_MS=8000

# Alternativa não usada em produção no momento: serviço próprio Kokoro+Piper
# em services/tts (veja services/tts/README.md). Nenhuma hospedagem grátis
# viável foi encontrada para os dois modelos juntos; mantido caso um host
# próprio ou pago volte a fazer sentido no futuro.
# TTS_SERVICE_URL=
# TTS_SERVICE_TOKEN=

# Integração com o Google Agenda (leitura). Veja docs/GOOGLE_CALENDAR_SETUP.md
# para o passo a passo de criação das credenciais no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Chave AES-256 em base64 (32 bytes), usada só para cifrar o cookie de sessão
# do Google. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_SESSION_SECRET=

# Modo Sala (multiplayer). Veja docs/ROOM_SETUP.md para o passo a passo de
# criação do projeto Firebase e da conta de serviço.
FIREBASE_DATABASE_URL=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Configuração pública do Firebase Web para login Google.
# Copiar de Configurações do projeto > Seus apps. Não usar segredo OAuth aqui.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Necessário quando o banco não usa a região/endereço padrão derivado do projeto.
VITE_FIREBASE_DATABASE_URL=
